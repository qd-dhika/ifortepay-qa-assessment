{
  "name": "ifortepay-web-test-automation",
  "version": "1.0.0",
  "description": "Web UI test automation for Sign Up / Sign In (automationexercise.com) using Cypress + Cucumber (Gherkin BDD)",
  "private": true,
  "scripts": {
    "test": "cypress run --browser chrome",
    "test:open": "cypress open",
    "test:report": "cypress run --browser chrome --reporter mochawesome --reporter-options reportDir=reports,overwrite=true,html=true,json=false"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^21.0.3",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^13.17.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.2",
    "mochawesome": "^7.1.3"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/support/step_definitions/**/*.js"
    ],
    "filterSpecs": true,
    "omitFiltered": true
  }
}
